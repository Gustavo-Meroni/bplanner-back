// Este é o seu arquivo de configuração do Prisma.
// Aqui nós dizemos como ele se conecta ao banco e como são as nossas tabelas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Aporte {
  id          String   @id @default(uuid())
  descricao   String
  valor       Float
  mes         String
  createdAt   DateTime @default(now())
}

model Despesa {
  id          String   @id @default(uuid())
  descricao   String
  valor       Float
  mes         String
  responsavel String
  vencimento  String?  // <-- Adicionamos esta linha!
  isPaga      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String   // Aqui guardaremos a senha criptografada (hash)
  createdAt DateTime @default(now())
}