// Este é o seu arquivo de configuração do Prisma.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String
  createdAt DateTime @default(now())

  // Relação com o Casal (opcional enquanto não ingressou em um)
  casalId   String?
  casal     Casal?   @relation(fields: [casalId], references: [id])
}

model Casal {
  id            String    @id @default(uuid())
  nome          String    // Ex: "Finanças do Casal"
  codigoConvite String    @unique // Código para o parceiro entrar (Ex: "XY7A92")
  createdAt     DateTime  @default(now())

  parceiros     Usuario[]
  despesas      Despesa[]
  aportes       Aporte[]
}

model Aporte {
  id        String   @id @default(uuid())
  descricao String
  valor     Float
  mes       String
  createdAt DateTime @default(now())

  casalId   String?
  casal     Casal?   @relation(fields: [casalId], references: [id])
}

model Despesa {
  id          String   @id @default(uuid())
  descricao   String
  valor       Float
  mes         String
  responsavel String   // Nome de quem é responsável pela conta ex: "Gustavo" ou "Par"
  vencimento  String?
  isPaga      Boolean  @default(false)
  isFixa      Boolean  @default(false)
  createdAt   DateTime @default(now())

  casalId     String?
  casal       Casal?   @relation(fields: [casalId], references: [id])
}