generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String
  createdAt DateTime @default(now())

  // Relação com o Casal
  casalId   String?
  casal     Casal?   @relation(fields: [casalId], references: [id])
}

model Casal {
  id            String    @id @default(uuid())
  nome          String    
  codigoConvite String    @unique 
  metaViagem    Float     @default(0) // <-- ADICIONADO AQUI
  createdAt     DateTime  @default(now())

  parceiros     Usuario[]
  aportes       Aporte[]
  perfis        Perfil[]  
}

model Aporte {
  id        String   @id @default(uuid())
  descricao String
  valor     Float
  mes       String
  createdAt DateTime @default(now())

  casalId   String?
  casal     Casal?   @relation(fields: [casalId], references: [id])
}

model Perfil {
  id        String      @id @default(uuid())
  name      String      // Ex: "Planejamento Gustavo"
  limit     Float       @default(0) // Limite de gastos
  
  casalId   String
  casal     Casal       @relation(fields: [casalId], references: [id])
  
  categories Categoria[]
}

model Categoria {
  id        String    @id @default(uuid())
  name      String    // Ex: "Moradia", "Lazer"
  
  perfilId  String
  perfil    Perfil    @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  
  items     Despesa[]
}

model Despesa {
  id          String   @id @default(uuid())
  name        String   
  value       Float    
  mes         String
  checked     Boolean  @default(false) 
  isFixa      Boolean  @default(false)
  createdAt   DateTime @default(now())

  categoryId  String
  category    Categoria @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  casalId     String?
}