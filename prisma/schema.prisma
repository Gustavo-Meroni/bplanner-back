generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Convenções
//  - Dinheiro sempre em centavos (Int): evita erros de arredondamento do Float
//  - Datas de calendário (vencimento, ida, volta, aporte) usam @db.Date
//  - Tudo que é da viagem pendura em viagemId; o acesso é checado pela
//    participação do usuário na viagem (ver ViagemGuard)
// ─────────────────────────────────────────────────────────────────────────────

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String
  createdAt DateTime @default(now())

  participacoes   Participante[]
  convitesCriados Convite[]
}

/// Uma viagem planejada por 1 ou mais pessoas
model Viagem {
  id   String @id @default(uuid())
  nome String

  // Origem (opcional, usada para desenhar a rota e o código no cartão de embarque)
  origemNome      String?
  origemLat       Float?
  origemLng       Float?

  /// Como vão viajar (opcional): muda o ícone da rota e sugere os gastos
  transporte TipoTransporte?

  dataIda   DateTime? @db.Date
  dataVolta DateTime? @db.Date

  metaCentavos Int   @default(0)
  /// Detalhamento da estimativa feita no onboarding (passagem, hospedagem, diária...)
  estimativa   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Destinos em ordem (1 ou mais). Sem paradas = viagem ainda não configurada
  paradas       Parada[]
  participantes Participante[]
  convites      Convite[]
  aportes       Aporte[]
  custos        Custo[]
}

/// Uma cidade do roteiro. A viagem pode ter várias (ex.: Buenos Aires → Mendoza)
model Parada {
  id         String    @id @default(uuid())
  ordem      Int
  nome       String
  regiao     String?
  pais       String?
  codigoPais String?
  lat        Float
  lng        Float
  /// Datas por parada (para uma versão futura do roteiro)
  chegada    DateTime? @db.Date
  saida      DateTime? @db.Date

  viagemId String
  viagem   Viagem @relation(fields: [viagemId], references: [id], onDelete: Cascade)

  @@unique([viagemId, ordem])
}

enum TipoTransporte {
  AVIAO
  CARRO
  ONIBUS
  OUTRO
}

enum PapelParticipante {
  DONO
  MEMBRO
}

/// Liga um usuário a uma viagem (N:N)
model Participante {
  id       String            @id @default(uuid())
  papel    PapelParticipante @default(MEMBRO)
  entrouEm DateTime          @default(now())

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  viagemId  String
  viagem    Viagem  @relation(fields: [viagemId], references: [id], onDelete: Cascade)

  aportes         Aporte[]
  custosAssumidos Custo[]

  @@unique([usuarioId, viagemId])
  @@index([viagemId])
}

/// Link de convite reutilizável: /convite/{codigo}
model Convite {
  id        String    @id @default(uuid())
  codigo    String    @unique
  expiraEm  DateTime?
  createdAt DateTime  @default(now())

  viagemId    String
  viagem      Viagem   @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  criadoPorId String?
  criadoPor   Usuario? @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@index([viagemId])
}

/// Dinheiro guardado para a viagem
model Aporte {
  id            String   @id @default(uuid())
  descricao     String
  valorCentavos Int
  data          DateTime @db.Date
  createdAt     DateTime @default(now())

  viagemId       String
  viagem         Viagem        @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  /// Quem guardou (opcional)
  participanteId String?
  participante   Participante? @relation(fields: [participanteId], references: [id], onDelete: SetNull)

  @@index([viagemId, data])
}

enum CategoriaCusto {
  TRANSPORTE
  HOSPEDAGEM
  ALIMENTACAO
  PASSEIOS
  COMPRAS
  SEGURO
  DOCUMENTOS
  OUTROS
}

/// Um gasto da viagem (passagem, hotel, passeio...). Sempre tem 1+ parcelas.
model Custo {
  id                 String         @id @default(uuid())
  nome               String
  categoria          CategoriaCusto @default(OUTROS)
  /// Soma das parcelas (mantida pelo serviço)
  valorTotalCentavos Int
  observacao         String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  viagemId      String
  viagem        Viagem        @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  /// Quem é responsável por pagar (opcional)
  responsavelId String?
  responsavel   Participante? @relation(fields: [responsavelId], references: [id], onDelete: SetNull)

  parcelas Parcela[]

  @@index([viagemId])
}

/// Parcela de um custo. À vista = 1 parcela.
model Parcela {
  id            String    @id @default(uuid())
  numero        Int
  valorCentavos Int
  vencimento    DateTime  @db.Date
  /// Data em que foi paga; nulo = pendente
  pagaEm        DateTime? @db.Date
  /// Paga com o dinheiro do cofre (aportes)? Evita contar o mesmo dinheiro duas vezes
  pagaComCofre  Boolean   @default(false)
  /// Já estava paga quando a viagem foi planejada: fica fora da meta e do progresso
  anteriorAoPlano Boolean @default(false)

  custoId String
  custo   Custo  @relation(fields: [custoId], references: [id], onDelete: Cascade)

  @@unique([custoId, numero])
  @@index([vencimento])
}
