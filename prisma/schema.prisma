// Este é o seu arquivo de configuração do Prisma.
// Aqui nós dizemos como ele se conecta ao banco e como são as nossas tabelas.

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------
// TABELAS (MODELOS)
// ---------------------------------------------------------

// Tabela 1: O Cofre (Aportes)
// Guarda o dinheiro que está crescendo. Ex: "Saldo Inicial", "Aporte Agosto".
model Aporte {
id        String   @id @default(uuid()) // Gera um ID único estilo 'abc-123'
descricao String
valor     Float    // Ex: 900.50
categoria String   @default("ESSENCIAL") // "ESSENCIAL" (Meta) ou "LAZER"
createdAt DateTime @default(now()) // Data em que foi criado
}

// Tabela 2: O Planejamento (Despesas)
// Guarda as obrigações a serem pagas mensalmente. Ex: "Airbnb", "Decolar".
model Despesa {
id          String   @id @default(uuid())
descricao   String
valor       Float
mes         String   // Ex: 'Ago/2026' (Usado para o sistema de Tabs)
isPaga      Boolean  @default(false) // O nosso 'check' começa sempre falso
responsavel String   // Ex: 'GUSTAVO' ou 'RAFAELA'
createdAt   DateTime @default(now())
}